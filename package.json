{
  "name": "mongil-star-dive-tools",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx --yes serve@14.2.4 out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "validate:data": "tsx scripts/validate-data.ts",
    "check": "npm run typecheck && npm run lint && npm run selftest && npm run validate:data",
    "selftest": "tsx scripts/selftest.ts",
    "crop:codex": "tsx scripts/crop-codex.mts"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
